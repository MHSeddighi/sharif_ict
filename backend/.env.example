# ─────────────────────────────────────────────────
# Backend Environment Variables
# ─────────────────────────────────────────────────
# Copy this file to .env:
#   cp .env.example .env
#
# ─── App ─────────────────────────────────────────

APP_NAME=Hackathon Starter Kit
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-secret-key
APP_HOST=0.0.0.0
APP_PORT=8000
APP_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ─── Database ────────────────────────────────────

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hackathon
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/hackathon

# ─── Redis ───────────────────────────────────────

REDIS_URL=redis://localhost:6379/0

# ─── JWT ─────────────────────────────────────────

JWT_SECRET_KEY=change-me-to-a-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ─── File Upload ─────────────────────────────────

UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_EXTENSIONS=["jpg","jpeg","png","gif","webp","pdf","doc","docx","csv","json"]
